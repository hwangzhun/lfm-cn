{
  "manifest_version": 3,
  "name": "LFM 中文汉化",
  "description": "Low Fuel Motorsport 简体中文界面汉化，支持动态页面与原文恢复。",
  "version": "0.2.0",
  "content_scripts": [
    {
      "matches": [
        "https://lowfuelmotorsport.com/*",
        "https://www.lowfuelmotorsport.com/*"
      ],
      "js": [
        "translations/common.js",
        "translations/legacy-routes.js",
        "translations/header-top.js",
        "translations/home.js",
        "translations/faq.js",
        "translations/lfmplus.js",
        "translations/lfmapp.js",
        "translations/racing-official.js",
        "translations/series.js",
        "translations/statistics.js",
        "translations/seasonsraces.js",
        "translations/achievements.js",
        "translations/penalties.js",
        "translations/myaccount-myraces.js",
        "translations/ac-app-card.js",
        "translations/lfm-support-widget.js",
        "translations/footer.js",
        "translations/track.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_title": "LFM 中文汉化",
    "default_popup": "popup.html"
  }
}
